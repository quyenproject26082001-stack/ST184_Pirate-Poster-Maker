<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vòng tròn ngoài - Viền Cam -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#C4561B"/>
            <size
                android:width="3dp"
                android:height="5dp"/>
        </shape>
    </item>

    <!-- Vòng tròn trong - Màu trắng -->
    <item

        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size
                android:width="5dp"
                android:height="5dp"/>
        </shape>
    </item>

</layer-list>