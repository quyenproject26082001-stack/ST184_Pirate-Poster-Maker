<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_edit">

    <!-- Action Bar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <!-- Poster Preview - Container for dynamic template layouts -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvPosterPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardElevation="4dp">

                <!-- Container to inflate template layouts dynamically -->
                <FrameLayout
                    android:id="@+id/containerPoster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->            <!-- Import Photo Button -->
            <FrameLayout
                android:id="@+id/btnImportPhoto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:background="@drawable/img_btn_bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Import Photo"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- Remove Background Button -->
            <FrameLayout
                android:id="@+id/btnRemoveBackground"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:background="@drawable/img_btn_bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Remove Background"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- Reset Button -->
            <FrameLayout
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:background="@drawable/img_btn_bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/roboto_medium"
                    android:text="Reset"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- Name Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFF4E6"
           >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Name Header -->
                    <LinearLayout
                        android:id="@+id/layoutNameHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Name"
                            android:textColor="#C4561B"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/imgNameArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_down"
                          />
                    </LinearLayout>

                    <!-- Name Content -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutNameContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:visibility="gone">

                        <!-- Input Label -->
                        <TextView
                            android:id="@+id/tvInputLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Input"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Input Name -->
                        <EditText
                            android:id="@+id/edtName"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_16_stroke_white"
                            android:fontFamily="@font/roboto_regular"
                            android:hint="Enter name"
                            android:maxLength="15"
                            android:maxLines="2"
                            android:paddingHorizontal="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline2"
                            app:layout_constraintTop_toTopOf="@id/tvInputLabel"
                            app:layout_constraintBottom_toBottomOf="@id/tvInputLabel"
                            />

                        <!-- Font Label -->
                        <TextView
                            android:id="@+id/tvFontLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Fonts"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/edtName" />

                        <!-- Font Spinner -->
                        <Spinner
                            android:id="@+id/spinnerNameFont"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_16_stroke_white"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline2"
                            app:layout_constraintBottom_toBottomOf="@id/tvFontLabel"
                            app:layout_constraintTop_toTopOf="@id/tvFontLabel" />

                        <!-- Spacing Label -->
                        <TextView
                            android:id="@+id/tvSpacingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Spacing"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/spinnerNameFont" />

                        <!-- Spacing SeekBar -->
                        <SeekBar
                            android:id="@+id/seekBarNameSpacing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guideline2"
                            app:layout_constraintTop_toTopOf="@id/tvSpacingLabel"
                            app:layout_constraintBottom_toBottomOf="tvSpacingLabel"
                            />

                        <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/guideline2"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.29"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bounty Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFF4E6"
            >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Bounty Header -->
                    <LinearLayout
                        android:id="@+id/layoutBountyHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/bounty"
                            android:textColor="#C4561B"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/imgBountyArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_down"
                        />
                    </LinearLayout>

                    <!-- Bounty Content -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutBountyContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:visibility="gone">

                        <!-- Input Label -->
                        <TextView
                            android:id="@+id/tvBountyInputLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Input"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:id="@+id/edtBounty"
                            android:layout_width="0dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_16_stroke_white"
                            android:fontFamily="@font/roboto_regular"
                            android:hint="Enter bounty"
                            android:paddingHorizontal="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvBountyInputLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/tvBountyInputLabel" />

                        <!-- Size Label -->
                        <TextView
                            android:id="@+id/tvBountySizeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Size"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/edtBounty" />

                        <SeekBar
                            android:id="@+id/seekBarBountySize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvBountySizeLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/tvBountySizeLabel" />

                        <!-- Weight Label -->
                        <TextView
                            android:id="@+id/tvBountyWeightLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Weight"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarBountySize" />

                        <SeekBar
                            android:id="@+id/seekBarBountyWeight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvBountyWeightLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/tvBountyWeightLabel" />

                        <!-- Spacing Label -->
                        <TextView
                            android:id="@+id/tvBountySpacingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Spacing"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarBountyWeight" />

                        <SeekBar
                            android:id="@+id/seekBarBountySpacing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvBountySpacingLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/tvBountySpacingLabel" />

                        <!-- Position X Label -->
                        <TextView
                            android:id="@+id/tvBountyPositionXLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Position X"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarBountySpacing" />

                        <SeekBar
                            android:id="@+id/seekBarBountyPositionX"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvBountyPositionXLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/tvBountyPositionXLabel" />

                        <!-- Position Y Label -->
                        <TextView
                            android:id="@+id/tvBountyPositionYLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="Position Y"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarBountyPositionX" />

                        <SeekBar
                            android:id="@+id/seekBarBountyPositionY"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="50"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvBountyPositionYLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guideline1"
                            app:layout_constraintTop_toTopOf="@id/tvBountyPositionYLabel" />

                        <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/guideline1"
                            app:layout_constraintGuide_percent="0.29"
                            android:layout_height="wrap_content"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Photo Filter Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFF4E6"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Photo Filter Header -->
                    <LinearLayout
                        android:id="@+id/layoutPhotoFilterHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/photo_filter"
                            android:textColor="#C4561B"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/imgPhotoFilterArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_down"
                            />
                    </LinearLayout>

                    <!-- Photo Filter Content -->
                    <!-- ============================================ -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutPhotoFilterContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:visibility="gone">

                        <!-- Shadow Label -->
                        <TextView
                            android:id="@+id/tvFilterShadowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/shadow"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <SeekBar
                            android:id="@+id/seekBarFilterShadow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterShadowLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterShadowLabel" />

                        <!-- Blur Label -->
                        <TextView
                            android:id="@+id/tvFilterBlurLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/blur"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterShadow" />

                        <SeekBar
                            android:id="@+id/seekBarFilterBlur"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterBlurLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterBlurLabel" />

                        <!-- Brightness Label -->
                        <TextView
                            android:id="@+id/tvFilterBrightnessLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/brightness"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterBlur" />

                        <SeekBar
                            android:id="@+id/seekBarFilterBrightness"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="200"
                            android:progress="100"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterBrightnessLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterBrightnessLabel" />

                        <!-- Contrast Label -->
                        <TextView
                            android:id="@+id/tvFilterContrastLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/contrast"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterBrightness" />

                        <SeekBar
                            android:id="@+id/seekBarFilterContrast"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="200"
                            android:progress="100"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterContrastLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterContrastLabel" />

                        <!-- Grayscale Label -->
                        <TextView
                            android:id="@+id/tvFilterGrayscaleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/grayscale"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterContrast" />

                        <SeekBar
                            android:id="@+id/seekBarFilterGrayscale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterGrayscaleLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterGrayscaleLabel" />

                        <!-- Hue Rotate Label -->
                        <TextView
                            android:id="@+id/tvFilterHueRotateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/hue_rotate"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterGrayscale" />

                        <SeekBar
                            android:id="@+id/seekBarFilterHueRotate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="360"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterHueRotateLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterHueRotateLabel" />

                        <!-- Saturate Label -->
                        <TextView
                            android:id="@+id/tvFilterSaturateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/saturate"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterHueRotate" />

                        <SeekBar
                            android:id="@+id/seekBarFilterSaturate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="200"
                            android:progress="100"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterSaturateLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterSaturateLabel" />

                        <!-- Sepia Label -->
                        <TextView
                            android:id="@+id/tvFilterSepiaLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/sepia"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/seekBarFilterSaturate" />

                        <SeekBar
                            android:id="@+id/seekBarFilterSepia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvFilterSepiaLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidline"
                            app:layout_constraintTop_toTopOf="@id/tvFilterSepiaLabel" />

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guidline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_percent="0.29"
                             />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Poster Shadow Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFF4E6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Poster Shadow Header -->
                    <LinearLayout
                        android:id="@+id/layoutPosterShadowHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/poster_shadow"
                            android:textColor="#C4561B"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/imgPosterShadowArrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_down"
                            />
                    </LinearLayout>

                    <!-- Poster Shadow Content -->
                    <!-- ============================================ -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutPosterShadowContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:visibility="gone">

                        <!-- Shadow Label -->
                        <TextView
                            android:id="@+id/tvPosterShadowLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/kurale_regular"
                            android:text="@string/shadow"
                            android:textColor="@color/app"
                            android:textSize="16sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <SeekBar
                            android:id="@+id/seekBarPosterShadow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/seekbar_progress_orange"
                            android:thumb="@drawable/seekbar_thumb_orange"
                            app:layout_constraintBottom_toBottomOf="@id/tvPosterShadowLabel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/guidlinePosterShadow"
                            app:layout_constraintTop_toTopOf="@id/tvPosterShadowLabel" />

                        <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/guidlinePosterShadow"
                            app:layout_constraintGuide_percent="0.29"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

