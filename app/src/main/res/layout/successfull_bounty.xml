<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/img_bg_language"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".activity_app.bountyfilter.SuccessfulBountyActivity">




    <!-- Container for composite capture: background + camera + text -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerBounty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintDimensionRatio="328:480">


        <ImageView
            android:id="@+id/imgCamera"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.46"
            app:layout_constraintWidth_percent="0.87"
            app:layout_constraintVertical_bias="0.354"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:scaleType="centerCrop"

            />

        <ImageView
            android:id="@+id/imgPlaySuccess"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_bounty_playing"
            android:scaleType="fitXY"/>



        <TextView
            android:id="@+id/tvBountyFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.000.000"
            android:layout_gravity="center_horizontal"
            android:textSize="40sp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.82"
            android:textColor="#3B2104"
            android:fontFamily="@font/caslon_antique_regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!--    &lt;!&ndash; Dark overlay for initial dimming effect - placed before btnPlay so btnPlay is on top &ndash;&gt;-->
    <!--    <View-->
    <!--        android:id="@+id/darkOverlay"-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:layout_height="match_parent"-->
    <!--        android:background="#99000000"-->
    <!--        android:visibility="visible"-->
    <!--        android:clickable="false"-->
    <!--        android:focusable="false"/>-->

    <TextView
        android:id="@+id/btnDownload"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/containerBounty"
        android:background="@drawable/ic_play"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        android:text="@string/download"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/glcenter"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/kurale_regular"
        android:textSize="20sp"
        android:textColor="#C4561B"/>
    <TextView
        android:id="@+id/btnShare"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/containerBounty"
        app:layout_constraintEnd_toEndOf="@id/glcenter"
        android:background="@drawable/ic_play"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:text="@string/share"
        android:gravity="center"
        android:fontFamily="@font/kurale_regular"
        android:textSize="20sp"
        android:textColor="#C4561B"/>

    <!-- White flash overlay for camera capture effect -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:alpha="0"/>

    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <androidx.constraintlayout.widget.Guideline android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"
        android:id="@+id/glcenter"
        />

    <!-- nativeClHome -->
    <FrameLayout
        android:id="@+id/nativeClBountySuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </FrameLayout>

    <!-- Native Collapsible Ad - Bottom -->
    <FrameLayout
        android:id="@+id/nativeCollapSSBounty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/ads_shimmer_collap_native" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>