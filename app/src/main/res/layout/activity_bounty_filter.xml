<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_language"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <!--    layoutActionBar-->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imgPlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        android:src="@drawable/img_bounty_start"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintDimensionRatio="328:480"
        />

    <TextView
        android:id="@+id/tvBountyFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2.000.000"
        app:layout_constraintStart_toStartOf="@id/imgPlay"
        app:layout_constraintEnd_toEndOf="@id/imgPlay"
        app:layout_constraintTop_toTopOf="@id/imgPlay"
        app:layout_constraintBottom_toBottomOf="@id/imgPlay"
        android:textSize="40sp"
        android:textColor="#3B2104"
        app:layout_constraintVertical_bias="0.83"
        android:fontFamily="@font/kurale_regular"/>

    <androidx.camera.view.PreviewView
        android:id="@+id/imgCamera"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.33"
        app:layout_constraintWidth_percent="0.76"
        app:layout_constraintVertical_bias="0.36"
        app:layout_constraintStart_toStartOf="@id/imgPlay"
        app:layout_constraintEnd_toEndOf="@id/imgPlay"
        app:layout_constraintTop_toTopOf="@id/imgPlay"
        app:layout_constraintBottom_toBottomOf="@id/imgPlay"
        />


        <TextView
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/imgPlay"
            android:background="@drawable/ic_play"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:text="@string/play"
            android:gravity="center"
            android:fontFamily="@font/kurale_regular"
            android:textSize="20sp"
            android:textColor="#C4561B"/>



</androidx.constraintlayout.widget.ConstraintLayout>